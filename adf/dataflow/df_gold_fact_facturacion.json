{
	"name": "df_gold_fact_facturacion",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_dw_bronze_hospital",
						"type": "DatasetReference"
					},
					"name": "origen"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dw_gold_fact_facturacion",
						"type": "DatasetReference"
					},
					"name": "destino"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    dp.paciente_key,\\n    dd.departamento_key,\\n    ds.servicio_cargo_key,\\n    CONVERT(INT, CONVERT(CHAR(8), b.payment_date, 112)) AS fecha_pago_key,\\n    b.amount AS monto_facturado,\\n    1 AS conteo_transacciones\\nFROM silver.billing b\\nJOIN silver.admissions a        ON a.admission_id = b.admission_id\\nJOIN gold.dim_paciente dp       ON dp.patient_id_bk = a.patient_id\\nJOIN gold.dim_departamento dd   ON dd.nombre_departamento = a.department\\nJOIN gold.dim_servicio_cargo ds ON ds.tipo_cargo = b.charge_type AND ds.estado_pago = b.payment_status',",
				"     format: 'query') ~> origen",
				"origen sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false) ~> destino"
			]
		}
	}
}